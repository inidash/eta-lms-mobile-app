{
  "expo": {
    "name": "Express Tech Academy",
    "slug": "express-tech-academy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "etaapp",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.eta.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/eta-splash.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0F1D",
          "image": "./assets/images/eta-splash.png",
          "imageWidth": 100
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5bcbf9ff-b0ba-486c-b321-22f160763716"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5bcbf9ff-b0ba-486c-b321-22f160763716"
    },
    "ios": {}
  }
}
